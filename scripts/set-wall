#!/usr/bin/env bash
# set-wall: one wallpaper command for images, videos and Wallpaper Engine.
#
#   set-wall <imagen>                 foto fija (awww)
#   set-wall <video.mp4|webm|mkv>     video (mpvpaper, mucho más barato que WPE para videos)
#   set-wall <ID del Workshop>        Wallpaper Engine: scene → linux-wallpaperengine, video → mpvpaper
#        --audio                      escena reactiva al audio (por defecto: --silent)
#        --fps N                      fps: escenas (por defecto 30) y videos (por defecto los del archivo)
#        --prop nombre=valor          opción de la escena; se guarda para ese ID (repetible; "nombre=" la quita)
#   set-wall --prop nombre=valor      cambia una opción del wallpaper actual y lo reaplica
#   set-wall --props [ID]             opciones disponibles de la escena y las que tienes guardadas
#   set-wall --reset-props [ID]       borra las opciones guardadas (y reaplica si es el actual)
#   set-wall --restore                vuelve a aplicar el último (para el autostart)
#   set-wall --list                   lista los wallpapers del Workshop (ID, tipo, título)
#   set-wall --stop                   detiene WPE / mpvpaper (deja la imagen fija)
#   set-wall --subscribed             lista los IDs a los que sigues suscrito en Steam
#   set-wall --prune [-y]             borra del disco los wallpapers a los que te desuscribiste
#
# Siempre deja un fotograma fijo puesto con awww DEBAJO del fondo animado:
#   - MacShell (vidrio) y MacLock (pantalla de bloqueo) leen el fondo con `awww query`
#   - si WPE / mpvpaper se caen, queda esa imagen en lugar de un fondo vacío
set -uo pipefail

WS="$HOME/.local/share/Steam/steamapps/workshop/content/431960"
ASSETS="$HOME/.local/share/Steam/steamapps/common/wallpaper_engine/assets"
STATE="$HOME/.config/set-wall/current"
CACHE="$HOME/.cache/set-wall"
PROPS="$HOME/.config/set-wall/props"     # props/<ID>: una línea nombre=valor por opción
mkdir -p "$(dirname "$STATE")" "$CACHE" "$PROPS"

ACF="$(dirname "$(dirname "$WS")")/appworkshop_431960.acf"

# subscribed_ids: IDs con "subscribedby" en WorkshopItemDetails del manifiesto de Steam.
# Steam no siempre borra la carpeta al desuscribirte, pero sí quita ese campo.
subscribed_ids() {
    [ -f "$ACF" ] || return 1
    awk '
        /"WorkshopItemDetails"/ { sec = 1; next }
        sec && /^\t}/ { sec = 0 }
        sec && match($0, /^[ \t]*"([0-9]+)"[ \t]*$/, m) { cur = m[1] }
        sec && /"subscribedby"/ && cur != "" { print cur }' "$ACF"
}

prune() { # prune [-y]: borra carpetas del Workshop (y sus cachés) que ya no están suscritas
    local subs id title cur del=() ans
    subs=$(subscribed_ids) || die "no encuentro $ACF"
    [ -n "$subs" ] || die "el manifiesto no lista ninguna suscripción; no borro nada por seguridad"
    cur=$(cut -f1 "$STATE" 2>/dev/null)
    for d in "$WS"/*/; do
        id=$(basename "$d")
        [[ "$id" =~ ^[0-9]+$ ]] || continue
        grep -qx "$id" <<< "$subs" && continue
        title=$(jq -r '.title // ""' "$d/project.json" 2>/dev/null)
        if [ "$id" = "$cur" ]; then printf '  omitido (está puesto ahora): %s  %s\n' "$id" "$title"; continue; fi
        printf '  %s  %s  (%s)\n' "$id" "$title" "$(du -sh "$d" | cut -f1)"
        del+=("$id")
    done
    [ ${#del[@]} -gt 0 ] || { echo "No hay wallpapers desuscritos en disco."; return 0; }
    if [ "${1:-}" != -y ]; then
        read -r -p "¿Borrar estos ${#del[@]} wallpapers? [s/N] " ans
        [[ "$ans" =~ ^[sSyY]$ ]] || { echo "Cancelado."; return 0; }
    fi
    for id in "${del[@]}"; do
        rm -rf -- "${WS:?}/$id" "$CACHE/wpe-$id.png" "$CACHE/prev-$id.png" "$CACHE/thumbs/$id.jpg"
    done
    echo "Borrados ${#del[@]} wallpapers."
}

die() { printf 'set-wall: %s\n' "$*" >&2; exit 1; }
monitor() { hyprctl monitors -j 2>/dev/null | jq -r '([.[] | select(.focused)][0] // .[0]).name'; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
is_video() { case "$(lower "$1")" in *.mp4|*.webm|*.mkv|*.mov|*.m4v) return 0;; esac; return 1; }
key_of() { printf '%s:%s' "$1" "$(stat -c %Y "$1" 2>/dev/null)" | md5sum | cut -c1-16; }

stop_anim() {
    pkill -x linux-wallpaper 2>/dev/null   # comm is truncated to 15 chars
    pkill -x mpvpaper 2>/dev/null
    for _ in $(seq 20); do pgrep -x linux-wallpaper >/dev/null || pgrep -x mpvpaper >/dev/null || return 0; sleep 0.1; done
    pkill -KILL -x linux-wallpaper 2>/dev/null; pkill -KILL -x mpvpaper 2>/dev/null; return 0
}

still() { # still <image>: put a still frame under everything
    pgrep -x awww-daemon >/dev/null || { setsid awww-daemon >/dev/null 2>&1 & }
    for _ in $(seq 30); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
    awww img "$1" --transition-type fade --transition-duration 0.6 >/dev/null 2>&1 \
        || awww img "$1" --transition-type none >/dev/null 2>&1
    sddm_sync "$1"
}

sddm_sync() { # local: copy the still to the MacLogin SDDM theme (the file is ours, so no sudo)
    local dst=/usr/share/sddm/themes/MacLogin/wallpaper.jpg tmp="${XDG_RUNTIME_DIR:-/tmp}/maclogin-wall.jpg"
    [ -w "$dst" ] || return 0
    ( magick "${1}[0]" -resize '2560x1440>' -quality 90 "jpg:$tmp" 2>/dev/null && cat "$tmp" > "$dst"; rm -f "$tmp" ) &
}

video_frame() { # video_frame <video> → prints a cached PNG frame
    local out="$CACHE/$(key_of "$1").png"
    [ -s "$out" ] || ffmpeg -loglevel error -y -ss 1 -i "$1" -frames:v 1 "$out" </dev/null \
        || ffmpeg -loglevel error -y -i "$1" -frames:v 1 "$out" </dev/null
    printf '%s' "$out"
}

# glass_notify <video|"">: tells MacShell which video is on the desktop, so its Liquid Glass (Control Center, menus)
# plays it too instead of a frozen frame. Retries ~20 s in the background (at login MacShell may not be up yet).
GLASS=""
glass_notify() {
    command -v qs >/dev/null || return 0
    ( for _ in $(seq 40); do qs -c MacShell ipc call wallpapers glassvideo "$1" >/dev/null 2>&1 && exit 0; sleep 0.5; done ) >/dev/null 2>&1 &
}

play_video() { # play_video <video>
    local mon opts; mon=$(monitor)
    GLASS="$1"
    still "$(video_frame "$1")"
    opts="no-audio loop-file=inf panscan=1.0 profile=fast framedrop=vo input-ipc-server=${XDG_RUNTIME_DIR:-/tmp}/set-wall-mpv.sock"
    if [ "$FPS" -gt 0 ] 2>/dev/null; then
        # limitar fps: el filtro necesita los frames en RAM, así que la decodificación por GPU pasa a modo copy
        opts+=" hwdec=auto-copy vf=fps=$FPS"
    else
        opts+=" hwdec=auto"
    fi
    setsid mpvpaper -o "$opts" "$mon" "$1" >/dev/null 2>&1 &
}

# ── Opciones de escena (properties de Wallpaper Engine) ───────────────────────
props_set() { # props_set <id> nombre=valor  ("nombre=" borra la opción)
    local f="$PROPS/$1" name="${2%%=*}" val="${2#*=}"
    [[ "$2" == *=* && -n "$name" ]] || die "--prop espera nombre=valor"
    touch "$f"
    grep -v -- "^$name=" "$f" > "$f.tmp"; mv "$f.tmp" "$f"
    [ -z "$val" ] || printf '%s=%s\n' "$name" "$val" >> "$f"
    [ -s "$f" ] || rm -f "$f"
}

props_show() { # props_show <id>
    local id="$1"
    [ -f "$WS/$id/project.json" ] || die "no encuentro el wallpaper $id en el Workshop"
    printf '%s — %s\n\n' "$id" "$(jq -r '.title // ""' "$WS/$id/project.json")"
    if [ "$(lower "$(jq -r '.type // ""' "$WS/$id/project.json")")" = scene ]; then
        echo "Opciones disponibles:"
        linux-wallpaperengine --assets-dir "$ASSETS" --list-properties "$WS/$id" 2>/dev/null \
            | grep -v -e '^Running with' -e '^Using wallpaper engine' | sed 's/^/  /'
    else
        echo "(es un video: no tiene opciones de escena; usa --fps)"
    fi
    echo; echo "Guardadas ($PROPS/$id):"
    if [ -s "$PROPS/$id" ]; then sed 's/^/  /' "$PROPS/$id"; else echo "  (ninguna)"; fi
}

current_id() { cut -f1 "$STATE" 2>/dev/null; }

play_scene() { # play_scene <dir> <id>
    local dir="$1" id="$2" mon frame prev args
    command -v linux-wallpaperengine >/dev/null || die "linux-wallpaperengine no está instalado"
    mon=$(monitor)
    frame="$CACHE/wpe-$id.png"
    if [ -s "$frame" ]; then
        still "$frame"
    else
        # until WPE writes its own frame, the Workshop preview stands in (first frame if it is a GIF)
        prev=$(ls "$dir"/preview.* 2>/dev/null | head -n1)
        if [ -n "$prev" ]; then magick "${prev}[0]" -resize 1920x1080^ -gravity center -extent 1920x1080 "$CACHE/prev-$id.png" 2>/dev/null \
            && still "$CACHE/prev-$id.png"; fi
    fi
    local fps="$FPS"; [ "$fps" -gt 0 ] 2>/dev/null || fps=30
    args=(--screen-root "$mon" --bg "$dir" --fps "$fps" --assets-dir "$ASSETS")
    [ "$AUDIO" = 1 ] || args+=(--silent)
    if [ -s "$PROPS/$id" ]; then
        local line
        while IFS= read -r line; do [ -n "$line" ] && args+=(--set-property "$line"); done < "$PROPS/$id"
    fi
    [ -s "$frame" ] || args+=(--screenshot "$frame" --screenshot-delay 60)
    setsid linux-wallpaperengine "${args[@]}" >/dev/null 2>&1 &
    if [ ! -s "$frame" ]; then
        # once the frame exists, swap the still underneath to it (runs in the background)
        ( for _ in $(seq 60); do [ -s "$frame" ] && { sleep 0.5; still "$frame"; exit 0; }; sleep 0.5; done ) &
    fi
}

apply() { # apply <target>
    local t="$1" dir type
    if [[ "$t" =~ ^[0-9]+$ ]]; then
        dir="$WS/$t"; [ -f "$dir/project.json" ] || die "no encuentro el wallpaper $t en el Workshop"
        type=$(lower "$(jq -r '.type // ""' "$dir/project.json")")
        case "$type" in
            scene) stop_anim; play_scene "$dir" "$t" ;;
            video) stop_anim; play_video "$dir/$(jq -r '.file' "$dir/project.json")" ;;
            web)   die "los wallpapers web no funcionan en linux-wallpaperengine r643 (se cierran); elige una escena o video" ;;
            *)     die "tipo desconocido: $type" ;;
        esac
    elif [ -f "$t" ] && is_video "$t"; then
        stop_anim; play_video "$(realpath "$t")"
    elif [ -f "$t" ]; then
        stop_anim; still "$(realpath "$t")"
    else
        die "no existe: $t"
    fi
    glass_notify "$GLASS"
    [[ "$t" =~ ^[0-9]+$ ]] || t=$(realpath "$t")
    printf '%s\t%s\t%s\n' "$t" "$AUDIO" "$FPS" > "$STATE"
}

load_state() { # vuelve a aplicar el actual con su audio y fps guardados
    [ -f "$STATE" ] || die "no hay wallpaper actual"
    IFS=$'\t' read -r TARGET AUDIO FPS < "$STATE"
}

AUDIO=0; FPS=0; TARGET=""; NEWPROPS=()    # FPS=0 → por defecto (30 en escenas, nativo en videos)
while [ $# -gt 0 ]; do
    case "$1" in
        --audio) AUDIO=1 ;;
        --fps) shift; [[ "${1:-}" =~ ^[0-9]+$ ]] || die "--fps espera un número"; FPS="$1" ;;
        --prop) shift; NEWPROPS+=("${1:-}") ;;
        --props) props_show "${2:-$(current_id)}"; exit 0 ;;
        --reset-props)
            id="${2:-$(current_id)}"; [[ "$id" =~ ^[0-9]+$ ]] || die "--reset-props espera un ID"
            rm -f "$PROPS/$id"; echo "Opciones de $id borradas."
            [ "$id" = "$(current_id)" ] || exit 0
            load_state ;;
        --stop) stop_anim; glass_notify ""; exit 0 ;;
        --subscribed) subscribed_ids || die "no encuentro $ACF"; exit 0 ;;
        --prune) shift; prune "${1:-}"; exit 0 ;;
        --list)
            for d in "$WS"/*/; do id=$(basename "$d")
                jq -r --arg id "$id" '"\($id)\t\(.type|ascii_downcase)\t\(.title)"' "$d/project.json" 2>/dev/null; done | column -t -s $'\t'
            exit 0 ;;
        --restore)
            [ -f "$STATE" ] || exit 0
            load_state
            # Hyprland may still be bringing outputs up at login
            for _ in $(seq 50); do [ -n "$(monitor)" ] && [ "$(monitor)" != null ] && break; sleep 0.2; done ;;
        -h|--help) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) TARGET="$1" ;;
    esac
    shift
done
if [ ${#NEWPROPS[@]} -gt 0 ]; then
    if [ -z "$TARGET" ]; then  # sin ID: cambiar el actual conservando su audio y fps
        cli_fps="$FPS"; cli_audio="$AUDIO"; load_state
        [ "$cli_fps" -gt 0 ] && FPS="$cli_fps"; [ "$cli_audio" = 1 ] && AUDIO=1
    fi
    [[ "$TARGET" =~ ^[0-9]+$ ]] || die "--prop solo sirve con escenas del Workshop"
    for p in "${NEWPROPS[@]}"; do props_set "$TARGET" "$p"; done
fi
[ -n "$TARGET" ] || { sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
apply "$TARGET"
# aplica de inmediato la pausa automática (si hay ventanas abiertas, el fondo nuevo arranca pausado)
command -v wall-autopause >/dev/null && { sleep 1.5; wall-autopause --apply; } >/dev/null 2>&1 &
